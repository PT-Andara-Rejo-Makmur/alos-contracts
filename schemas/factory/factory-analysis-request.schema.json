{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.alos.dev/v1/factory/factory-analysis-request.schema.json",
  "title": "FactoryAnalysisRequest",
  "description": "Internal Backend-to-GENESIS request with authoritative context and a read-only catalog snapshot.",
  "type": "object",
  "required": ["requirement", "capability_catalog"],
  "properties": {
    "requirement": { "$ref": "https://schemas.alos.dev/v1/factory/requirement.schema.json" },
    "capability_catalog": {
      "type": "array",
      "items": { "$ref": "https://schemas.alos.dev/v1/factory/capability-catalog-item.schema.json" }
    }
  },
  "additionalProperties": false
}
