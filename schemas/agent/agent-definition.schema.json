{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.alos.dev/v1/agent/agent-definition.schema.json",
  "title": "AgentDefinition",
  "type": "object",
  "required": ["agent_id", "agent_version", "name", "purpose", "capability_ids", "skill_refs", "model_policy_ref", "delegation_policy"],
  "properties": {
    "agent_id": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/agent_id" },
    "agent_version": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/agent_version" },
    "name": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "capability_ids": { "type": "array", "minItems": 1, "items": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/capability_id" }, "uniqueItems": true },
    "skill_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skill_id", "skill_version"],
        "properties": {
          "skill_id": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/skill_id" },
          "skill_version": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/skill_version" }
        },
        "additionalProperties": false
      }
    },
    "model_policy_ref": { "type": "string", "minLength": 1 },
    "delegation_policy": {
      "type": "object",
      "required": ["enabled", "max_depth"],
      "properties": { "enabled": { "type": "boolean" }, "max_depth": { "type": "integer", "minimum": 0 } },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
