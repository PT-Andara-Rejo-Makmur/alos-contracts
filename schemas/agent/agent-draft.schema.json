{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.alos.dev/v1/agent/agent-draft.schema.json",
  "title": "AgentDraft",
  "description": "A non-authoritative Agent proposal. Backend governance is required before approval or activation.",
  "type": "object",
  "required": ["draft_id", "tenant_id", "organization_id", "workspace_id", "correlation_id", "agent_id", "version", "purpose", "capability_type", "scope_refs", "tool_ids", "permission_refs", "prohibited_actions", "risk_level", "evidence_requirements", "test_requirements", "lifecycle_state", "agent_definition"],
  "properties": {
    "draft_id": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/canonical_id" },
    "tenant_id": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/tenant_id" },
    "organization_id": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/organization_id" },
    "workspace_id": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/workspace_id" },
    "correlation_id": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/correlation_id" },
    "agent_id": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/agent_id" },
    "version": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/semantic_version" },
    "purpose": { "type": "string", "minLength": 1 },
    "capability_type": { "const": "AGENT" },
    "scope_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "tool_ids": { "type": "array", "items": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/canonical_id" }, "uniqueItems": true },
    "permission_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "prohibited_actions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "risk_level": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "evidence_requirements": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "test_requirements": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "lifecycle_state": { "const": "DRAFT" },
    "agent_definition": {
      "allOf": [
        { "$ref": "https://schemas.alos.dev/v1/agent/agent-definition.schema.json" },
        { "properties": { "output_state": { "const": "DRAFT" } }, "required": ["output_state"] }
      ]
    }
  },
  "additionalProperties": false
}
