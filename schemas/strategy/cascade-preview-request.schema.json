{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.alos.dev/v1/strategy/cascade-preview-request.schema.json",
  "title": "CascadePreviewRequest",
  "type": "object",
  "required": [
    "root_target_ref",
    "rules",
    "rule_inputs",
    "assumption_refs",
    "constraints"
  ],
  "properties": {
    "root_target_ref": {
      "type": "object",
      "required": [
        "target_id",
        "version"
      ],
      "properties": {
        "target_id": {
          "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/target_id"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://schemas.alos.dev/v1/strategy/cascade-rule.schema.json"
      }
    },
    "rule_inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "assumption_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/assumption_id"
      },
      "uniqueItems": true
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "constraint_id",
          "constraint_type",
          "critical",
          "required_value",
          "available_value"
        ],
        "properties": {
          "constraint_id": {
            "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/constraint_id"
          },
          "constraint_type": {
            "type": "string",
            "enum": [
              "INVENTORY",
              "BUDGET",
              "CAPACITY",
              "DEPENDENCY",
              "PERIOD",
              "AUTHORITY",
              "EVIDENCE"
            ]
          },
          "critical": {
            "type": "boolean"
          },
          "required_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "available_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "applies": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "derived_targets": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.alos.dev/v1/strategy/business-target-create-request.schema.json"
      }
    }
  },
  "additionalProperties": false
}
