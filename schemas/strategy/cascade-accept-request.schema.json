{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.alos.dev/v1/strategy/cascade-accept-request.schema.json",
  "title": "CascadeAcceptRequest",
  "type": "object",
  "properties": {
    "derived_targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://schemas.alos.dev/v1/strategy/business-target-create-request.schema.json"
      }
    },
    "input_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "result_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "derived_targets"
  ],
  "additionalProperties": false
}
