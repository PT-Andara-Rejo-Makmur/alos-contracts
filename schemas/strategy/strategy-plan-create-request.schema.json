{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.alos.dev/v1/strategy/strategy-plan-create-request.schema.json",
  "title": "StrategyPlanCreateRequest",
  "type": "object",
  "required": ["plan_id", "version", "plan_type", "name", "owner_workspace_id", "owner_role_ref", "period", "scope", "materiality", "source_refs", "evidence_refs"],
  "properties": {
    "plan_id": {"$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/plan_id"},
    "version": {"type": "integer", "minimum": 1},
    "plan_type": {"type": "string", "enum": ["STRATEGIC_PLAN", "OPERATING_PLAN"]},
    "strategic_plan_id": {"oneOf": [{"$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/plan_id"}, {"type": "null"}]},
    "strategic_plan_version": {"type": ["integer", "null"], "minimum": 1},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": ["string", "null"]},
    "owner_workspace_id": {"$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/workspace_id"},
    "owner_role_ref": {"type": "string", "minLength": 1},
    "period": {"$ref": "https://schemas.alos.dev/v1/strategy/business-period.schema.json"},
    "scope": {"$ref": "https://schemas.alos.dev/v1/strategy/business-scope.schema.json"},
    "materiality": {"type": "string", "enum": ["MATERIAL", "NON_MATERIAL"]},
    "source_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence_refs": {"type": "array", "items": {"$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/evidence_id"}, "uniqueItems": true}
  },
  "dependentRequired": {"strategic_plan_id": ["strategic_plan_version"]},
  "additionalProperties": false
}
