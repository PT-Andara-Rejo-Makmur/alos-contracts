{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.alos.dev/v1/strategy/business-target-detail.schema.json",
  "title": "BusinessTargetDetail",
  "type": "object",
  "required": ["target", "observations", "relationships", "revisions"],
  "properties": {
    "target": { "$ref": "https://schemas.alos.dev/v1/strategy/business-target.schema.json" },
    "observations": {
      "type": "array",
      "items": { "$ref": "https://schemas.alos.dev/v1/strategy/metric-observation.schema.json" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "https://schemas.alos.dev/v1/strategy/target-relationship.schema.json" }
    },
    "revisions": {
      "type": "array",
      "items": { "$ref": "https://schemas.alos.dev/v1/strategy/target-revision.schema.json" }
    }
  },
  "additionalProperties": false
}
