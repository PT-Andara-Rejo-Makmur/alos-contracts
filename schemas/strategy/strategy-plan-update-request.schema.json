{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.alos.dev/v1/strategy/strategy-plan-update-request.schema.json",
  "title": "StrategyPlanUpdateRequest",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner_role_ref": {
      "type": "string",
      "minLength": 1
    },
    "period": {
      "$ref": "https://schemas.alos.dev/v1/strategy/business-period.schema.json"
    },
    "materiality": {
      "type": "string",
      "enum": [
        "MATERIAL",
        "NON_MATERIAL"
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/evidence_id"
      },
      "uniqueItems": true
    }
  },
  "required": [],
  "additionalProperties": false
}
