{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.alos.dev/v1/strategy/strategy-overview-projection.schema.json",
  "title": "StrategyOverviewProjection",
  "type": "object",
  "properties": {
    "active_strategic_plans": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.alos.dev/v1/strategy/strategic-plan.schema.json"
      }
    },
    "active_operating_plans": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.alos.dev/v1/strategy/operating-plan.schema.json"
      }
    },
    "plans": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "https://schemas.alos.dev/v1/strategy/strategic-plan.schema.json"
          },
          {
            "$ref": "https://schemas.alos.dev/v1/strategy/operating-plan.schema.json"
          }
        ]
      }
    },
    "objectives": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.alos.dev/v1/strategy/strategic-objective.schema.json"
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.alos.dev/v1/strategy/business-target-detail.schema.json"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.alos.dev/v1/strategy/planning-assumption.schema.json"
      }
    },
    "last_updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "required": [
    "active_strategic_plans",
    "active_operating_plans",
    "plans",
    "objectives",
    "targets",
    "assumptions",
    "last_updated_at"
  ],
  "additionalProperties": false
}
