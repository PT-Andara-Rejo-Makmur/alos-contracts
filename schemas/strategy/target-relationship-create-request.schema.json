  "properties": {
    "relationship_id": {"$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/relationship_id"},
    "relationship_type": {"type": "string", "enum": ["CASCADE", "CONTRIBUTES_TO", "DEPENDS_ON"]},
    "parent_target_id": {"$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/target_id"},
    "parent_target_version": {"type": "integer", "minimum": 1},
    "child_target_id": {"$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/target_id"},
    "child_target_version": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": false
