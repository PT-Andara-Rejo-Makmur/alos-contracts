{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.alos.dev/v1/identity/password-reset-confirm-request.schema.json",
  "title": "Password Reset Confirm Request",
  "description": "Confirm password reset using a one-time reset token.",
  "type": "object",
  "additionalProperties": false,
  "required": ["token", "password", "password_confirmation"],
  "properties": {
    "token": {"type": "string", "minLength": 20, "maxLength": 256},
    "password": {"type": "string", "minLength": 8, "maxLength": 256},
    "password_confirmation": {"type": "string", "minLength": 8, "maxLength": 256}
  }
}
