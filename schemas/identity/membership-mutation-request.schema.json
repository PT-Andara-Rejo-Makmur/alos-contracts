{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.alos.dev/v1/identity/membership-mutation-request.schema.json",
  "title": "Membership Mutation Request",
  "description": "Requested membership role and effective dates. Backend derives permissions, scopes, and data scope from policy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["workspace_id", "role_refs", "effective_at"],
  "properties": {
    "workspace_id": {"$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/workspace_id"},
    "role_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "https://schemas.alos.dev/v1/identity/authorization-vocabulary.schema.json#/$defs/authorization_role"}
    },
    "effective_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": ["string", "null"], "format": "date-time"},
    "note": {"type": ["string", "null"], "maxLength": 2000}
  }
}
