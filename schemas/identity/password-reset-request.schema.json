{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.alos.dev/v1/identity/password-reset-request.schema.json",
  "title": "Password Reset Request",
  "description": "Public request to initiate password recovery for an account.",
  "type": "object",
  "additionalProperties": false,
  "required": ["email"],
  "properties": {
    "email": {"type": "string", "format": "email", "maxLength": 255}
  }
}
