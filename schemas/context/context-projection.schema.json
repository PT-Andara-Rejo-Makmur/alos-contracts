{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.alos.dev/v1/context/context-projection.schema.json",
  "title": "ContextProjection",
  "description": "Public, Backend-authoritative context lifecycle projection. It contains no raw permission snapshot and grants no authority.",
  "type": "object",
  "required": ["status", "correlation_id"],
  "properties": {
    "status": { "type": "string", "enum": ["ACTIVE", "DENIED", "NEEDS_INFORMATION", "UNAVAILABLE"] },
    "context_id": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/canonical_id" },
    "tenant_id": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/tenant_id" },
    "organization_id": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/organization_id" },
    "workspace_id": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/workspace_id" },
    "actor_id": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/actor_id" },
    "goal": { "type": "string", "minLength": 1 },
    "capability_id": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/capability_id" },
    "data_classification": { "$ref": "https://schemas.alos.dev/v1/common/data-classification.schema.json" },
    "scope_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "evidence_refs": { "type": "array", "items": { "$ref": "https://schemas.alos.dev/v1/evidence/evidence-ref.schema.json" } },
    "items": { "type": "array", "items": { "$ref": "https://schemas.alos.dev/v1/context/context-bundle.schema.json#/properties/items/items" } },
    "needs_info_reason": { "type": "string", "minLength": 1 },
    "denial_reason": { "type": "string", "minLength": 1 },
    "correlation_id": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/correlation_id" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "ACTIVE" } }, "required": ["status"] },
      "then": { "required": ["context_id", "tenant_id", "organization_id", "workspace_id", "actor_id", "data_classification", "scope_refs", "evidence_refs", "items"] }
    },
    {
      "if": { "properties": { "status": { "const": "DENIED" } }, "required": ["status"] },
      "then": { "required": ["denial_reason"] }
    },
    {
      "if": { "properties": { "status": { "const": "NEEDS_INFORMATION" } }, "required": ["status"] },
      "then": { "required": ["needs_info_reason"] }
    }
  ],
  "additionalProperties": false
}
