{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.alos.dev/v1/capability/capability-detail.schema.json",
  "title": "CapabilityDetail",
  "description": "Authoritative Backend projection of a registered capability version for AI and Frontend consumers. Exposes governance state, scope, permission, tool, risk, and approval lineage without database, ORM, or registry storage details.",
  "type": "object",
  "required": ["capability_id", "version", "name", "purpose", "owner", "capability_type", "lifecycle_state", "risk_level", "availability", "configuration_status", "scope_refs", "permission_refs", "backing_tool_ids", "prohibited_actions", "evidence_requirements", "test_requirements", "human_gate_required", "created_by", "correlation_id", "created_at"],
  "properties": {
    "capability_id": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/capability_id" },
    "version": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/semantic_version" },
    "name": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "capability_type": { "type": "string", "enum": ["AGENT", "SKILL", "WORKFLOW", "RULE", "VALIDATOR", "REPORT", "HUMAN_TASK", "SCHEDULE", "EVENT_HANDLER", "CONNECTOR_REQUIREMENT", "TOOL_REQUIREMENT", "COMPOSITE"] },
    "lifecycle_state": { "type": "string", "enum": ["DRAFT", "APPROVED", "ACTIVE", "SUSPENDED", "RETIRED"] },
    "risk_level": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "availability": { "type": "string", "enum": ["AVAILABLE", "UNAVAILABLE", "DEGRADED"] },
    "configuration_status": { "type": "string", "enum": ["CONFIGURED", "NEEDS_CONFIGURATION", "NOT_APPLICABLE"] },
    "scope_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "permission_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "backing_tool_ids": { "type": "array", "items": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/canonical_id" }, "uniqueItems": true },
    "prohibited_actions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "evidence_requirements": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "test_requirements": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "constraints": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "dependency_refs": { "type": "array", "items": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/capability_id" }, "uniqueItems": true },
    "human_gate_required": { "type": "boolean" },
    "decision_id": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/decision_id" },
    "release_id": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/release_id" },
    "created_by": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/actor_id" },
    "correlation_id": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/correlation_id" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}