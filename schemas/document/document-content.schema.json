{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.alos.dev/v1/document/document-content.schema.json",
  "title": "DocumentContent",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "\\S"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source_id": {
      "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/source_id"
    },
    "source_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "truncated": {
      "type": "boolean"
    },
    "data_classification": {
      "type": "string",
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "RESTRICTED"
      ]
    },
    "instruction_authority": {
      "const": false
    }
  },
  "required": [
    "document_id",
    "title",
    "version",
    "source_id",
    "source_version",
    "content_hash",
    "content",
    "truncated",
    "data_classification",
    "instruction_authority"
  ],
  "additionalProperties": false
}
