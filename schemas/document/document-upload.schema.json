{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.alos.dev/v1/document/document-upload.schema.json",
  "title": "DocumentUpload",
  "type": "object",
  "properties": {
    "upload_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "document_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "filename": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "QUEUED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "attempts": {
      "type": "integer",
      "minimum": 0
    },
    "safe_error_code": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "source_id": {
      "anyOf": [
        {
          "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/source_id"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "upload_id",
    "document_id",
    "version",
    "filename",
    "content_hash",
    "size_bytes",
    "status",
    "attempts",
    "safe_error_code",
    "source_id"
  ],
  "additionalProperties": false
}
