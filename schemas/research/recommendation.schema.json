{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.alos.dev/v1/research/recommendation.schema.json",
  "title": "Recommendation",
  "description": "Non-authoritative AI or analyst recommendation; never represents approval.",
  "type": "object",
  "required": ["recommendation_id", "summary", "recommended_action", "confidence", "author_type"],
  "properties": {
    "recommendation_id": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/canonical_id" },
    "summary": { "type": "string", "minLength": 1 },
    "recommended_action": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "author_type": { "type": "string", "enum": ["AI", "HUMAN_ANALYST"] }
  },
  "additionalProperties": false
}
