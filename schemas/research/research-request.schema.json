{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.alos.dev/v1/research/research-request.schema.json",
  "title": "ResearchRequest",
  "type": "object",
  "required": ["research_id", "run_id", "question", "execution_context", "scope"],
  "properties": {
    "research_id": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/canonical_id" },
    "run_id": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/run_id" },
    "question": { "type": "string", "minLength": 1 },
    "execution_context": { "$ref": "https://schemas.alos.dev/v1/common/execution-context.schema.json" },
    "scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "constraints": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": false
}
