      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "tenant_id",
        "organization_id",
        "workspace_ids",
        "code",
        "name",
        "status",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "project_id": {
          "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/project_id"
        },
        "tenant_id": {
          "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/tenant_id"
        },
        "organization_id": {
          "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/organization_id"
        },
        "workspace_ids": {
          "type": "array",
          "items": {
            "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/workspace_id"
          },
          "uniqueItems": true
        },
        "code": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/ProjectStatus"
        },
        "owner_actor_id": {
          "type": [
            "string",
            "null"
          ]
