    "ProjectStatus": {
      "type": "string",
      "enum": [
        "PLANNED",
        "ACTIVE",
        "ON_HOLD",
        "COMPLETED",
        "CANCELLED",
        "ARCHIVED"
      ]
    },
    "TaskStatus": {
      "type": "string",
      "enum": [
        "OPEN",
        "IN_PROGRESS",
        "BLOCKED",
        "UNDER_REVIEW",
        "COMPLETED",
        "CANCELLED"
      ]
    },
    "TaskPriority": {
      "type": "string",
      "enum": [
        "LOW",
        "NORMAL",
        "HIGH",
        "CRITICAL"
      ]
    },
    "ApprovalStatus": {
      "type": "string",
      "enum": [
        "PENDING",
        "APPROVED",
        "RETURNED",
        "REJECTED",
        "HELD"
      ]
    },
    "ApprovalDecision": {
      "type": "string",
      "enum": [
        "APPROVED",
        "RETURNED",
        "REJECTED",
        "HOLD"
      ]
    },
    "DocumentStatus": {
      "type": "string",
      "enum": [
        "DRAFT",
        "IN_REVIEW",
        "APPROVED",
        "REJECTED",
        "RETIRED"
      ]
    },
    "ReportStatus": {
      "type": "string",
      "enum": [
        "DRAFT",
        "IN_REVIEW",
        "APPROVED",
        "PUBLISHED",
        "ARCHIVED"
      ]
    },
    "FindingStatus": {
      "type": "string",
      "enum": [
        "OPEN",
        "ASSIGNED",
        "IN_PROGRESS",
        "PENDING_VERIFICATION",
        "VERIFIED",
        "CLOSED"
      ]
    },
    "FindingSeverity": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "Permission": {
      "type": "string",
      "enum": [
        "project.read",
        "project.create",
        "project.update",
        "project.archive",
        "task.read",
        "task.create",
        "task.update",
        "task.assign",
        "task.complete",
        "approval.read",
        "approval.request",
        "approval.review",
        "approval.approve",
        "approval.return",
        "approval.reject",
        "approval.hold",
        "document.read",
        "document.create",
        "document.version",
        "document.review",
        "document.approve",
        "document.retire",
        "report.read",
        "report.create",
        "report.review",
        "report.publish",
        "report.archive",
        "finding.read",
        "finding.create",
        "finding.update",
        "finding.assign",
        "finding.verify",
        "finding.close"
