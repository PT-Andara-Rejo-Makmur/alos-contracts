{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.alos.dev/v1/skill/skill-definition.schema.json",
  "title": "SkillDefinition",
  "type": "object",
  "required": ["skill_id", "skill_version", "name", "description", "input_schema_ref", "output_schema_ref"],
  "properties": {
    "skill_id": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/skill_id" },
    "skill_version": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/skill_version" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "when_to_use": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "input_schema_ref": { "type": "string", "format": "uri" },
    "output_schema_ref": { "type": "string", "format": "uri" },
    "procedure": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "tool_ids": { "deprecated": true, "description": "Deprecated compatibility alias. Consumers MUST ignore this field; required_tool_ids is the sole canonical tool prerequisite.", "type": "array", "items": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/canonical_id" }, "uniqueItems": true },
    "required_tool_ids": { "description": "Minimum tool prerequisites. This declaration never grants tool authority.", "type": "array", "items": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/canonical_id" }, "uniqueItems": true },
    "owner_actor_id": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/actor_id" },
    "risk_level": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "permission_refs": { "description": "Minimum permission prerequisites. These references never grant permissions.", "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "scope_refs": { "description": "Minimum scope prerequisites. These references never expand scope.", "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "evidence_requirements": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "restrictions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "failure_modes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "escalation": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "evaluation": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": false
}
