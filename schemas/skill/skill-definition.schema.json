{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.alos.dev/v1/skill/skill-definition.schema.json",
  "title": "SkillDefinition",
  "type": "object",
  "required": ["skill_id", "skill_version", "name", "description", "input_schema_ref", "output_schema_ref"],
  "properties": {
    "skill_id": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/skill_id" },
    "skill_version": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/skill_version" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "when_to_use": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "input_schema_ref": { "type": "string", "format": "uri" },
    "output_schema_ref": { "type": "string", "format": "uri" },
    "procedure": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "required_tool_ids": { "type": "array", "items": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/canonical_id" }, "uniqueItems": true },
    "evidence_requirements": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "restrictions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "failure_modes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "escalation": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "evaluation": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": false
}
