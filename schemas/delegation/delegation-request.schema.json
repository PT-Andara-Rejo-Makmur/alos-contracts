{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.alos.dev/v1/delegation/delegation-request.schema.json",
  "title": "DelegationRequest",
  "type": "object",
  "required": ["run_id", "root_run_id", "parent_run_id", "agent_id", "agent_version", "depth", "execution_context", "task"],
  "properties": {
    "run_id": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/run_id" },
    "root_run_id": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/root_run_id" },
    "parent_run_id": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/parent_run_id" },
    "agent_id": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/agent_id" },
    "agent_version": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/agent_version" },
    "capability_id": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/capability_id" },
    "depth": { "type": "integer", "minimum": 1 },
    "execution_context": { "$ref": "https://schemas.alos.dev/v1/common/execution-context.schema.json" },
    "inherited_scope_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "inherited_permission_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "allowed_tool_ids": { "type": "array", "items": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/canonical_id" }, "uniqueItems": true },
    "execution_budget": { "$ref": "https://schemas.alos.dev/v1/runtime/execution-budget.schema.json" },
    "task": { "type": "object", "minProperties": 1 }
  },
  "additionalProperties": false
}
