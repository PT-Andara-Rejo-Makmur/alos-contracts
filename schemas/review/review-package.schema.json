{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.alos.dev/v1/review/review-package.schema.json",
  "title": "ReviewPackage",
  "description": "Assurance package. AI review and recommendation are advisory; only referenced IT and Director decisions are authoritative.",
  "type": "object",
  "required": ["identity", "purpose", "business_context", "capability", "scope", "permissions", "skills", "tools", "model_policy", "delegation_policy", "execution_budget", "automated_qa", "business_ai_review", "technical_ai_review", "security_ai_review", "evidence_ai_review", "cost_risk_ai_review", "findings", "risks", "limitations", "ai_recommendation", "evidence_refs"],
  "properties": {
    "identity": {
      "type": "object",
      "required": ["review_id", "tenant_id", "workspace_id", "correlation_id", "subject_id", "subject_version"],
      "properties": {
        "review_id": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/review_id" },
        "tenant_id": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/tenant_id" },
        "workspace_id": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/workspace_id" },
        "correlation_id": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/correlation_id" },
        "subject_id": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/canonical_id" },
        "subject_version": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/semantic_version" }
      },
      "additionalProperties": false
    },
    "purpose": { "type": "string", "minLength": 1 },
    "business_context": { "type": "object", "minProperties": 1 },
    "capability": { "$ref": "https://schemas.alos.dev/v1/capability/capability-draft.schema.json" },
    "scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "permissions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "skills": { "type": "array", "items": { "$ref": "https://schemas.alos.dev/v1/skill/skill-definition.schema.json" } },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tool_id", "purpose", "backend_executor"],
        "properties": {
          "tool_id": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/canonical_id" },
          "purpose": { "type": "string", "minLength": 1 },
          "backend_executor": { "const": true }
        },
        "additionalProperties": false
      }
    },
    "model_policy": {
      "type": "object",
      "required": ["gateway_required", "policy_ref"],
      "properties": { "gateway_required": { "const": true }, "policy_ref": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "delegation_policy": {
      "type": "object",
      "required": ["enabled", "lineage_required", "max_depth"],
      "properties": { "enabled": { "type": "boolean" }, "lineage_required": { "const": true }, "max_depth": { "type": "integer", "minimum": 0 } },
      "additionalProperties": false
    },
    "execution_budget": { "$ref": "https://schemas.alos.dev/v1/runtime/execution-budget.schema.json" },
    "automated_qa": {
      "type": "object",
      "required": ["status", "checks"],
      "properties": {
        "status": { "type": "string", "enum": ["PASS", "FAIL"] },
        "checks": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "business_ai_review": { "$ref": "https://schemas.alos.dev/v1/review/ai-review-result.schema.json" },
    "technical_ai_review": { "$ref": "https://schemas.alos.dev/v1/review/ai-review-result.schema.json" },
    "security_ai_review": { "$ref": "https://schemas.alos.dev/v1/review/ai-review-result.schema.json" },
    "evidence_ai_review": { "$ref": "https://schemas.alos.dev/v1/review/ai-review-result.schema.json" },
    "cost_risk_ai_review": { "$ref": "https://schemas.alos.dev/v1/review/ai-review-result.schema.json" },
    "findings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "risks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "ai_recommendation": { "$ref": "https://schemas.alos.dev/v1/research/recommendation.schema.json" },
    "evidence_refs": { "type": "array", "minItems": 1, "items": { "$ref": "https://schemas.alos.dev/v1/evidence/evidence-ref.schema.json" } },
    "it_decision": { "$ref": "https://schemas.alos.dev/v1/decision/decision-ref.schema.json" },
    "director_decision": { "$ref": "https://schemas.alos.dev/v1/decision/decision-ref.schema.json" }
  },
  "additionalProperties": false
}
