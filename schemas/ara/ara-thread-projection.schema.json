{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.alos.dev/v1/ara/ara-thread-projection.schema.json",
  "title": "AraThreadProjection",
  "type": "object",
  "properties": {
    "tenant_id": {
      "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/tenant_id"
    },
    "organization_id": {
      "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/organization_id"
    },
    "workspace_id": {
      "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/workspace_id"
    },
    "actor_id": {
      "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/actor_id"
    },
    "thread_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "status": {
      "$ref": "https://schemas.alos.dev/v1/ara/ara-thread-status.schema.json"
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "minLength": 1,
      "format": "date-time"
    }
  },
  "required": [
    "tenant_id",
    "organization_id",
    "workspace_id",
    "actor_id",
    "thread_id",
    "title",
    "status",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false
}
