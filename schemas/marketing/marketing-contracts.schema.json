            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "budget": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,2})?$",
              "description": "Exact decimal string; no binary floating-point amount."
            },
