{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.alos.dev/v1/common/error.schema.json",
  "title": "ContractError",
  "type": "object",
  "required": ["code", "message", "correlation_id", "retryable"],
  "properties": {
    "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
    "message": { "type": "string", "minLength": 1 },
    "details": { "type": "object" },
    "correlation_id": { "$ref": "https://schemas.alos.dev/v1/common/identifiers.schema.json#/$defs/correlation_id" },
    "retryable": { "type": "boolean" }
  },
  "additionalProperties": false
}
